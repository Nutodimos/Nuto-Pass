generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique
}

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  bloodType   String?
  sex         UserSex
  createdAt   DateTime     @default(now())
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id])
  attendances Attendance[]
  birthday    DateTime
  biometricId String?      @unique
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String
  img       String?
  bloodType String?
  sex       UserSex
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime
  materials Material[]
}



model Grade {
  id    Int @id @default(autoincrement())
  level Int @unique

  students Student[]
  classess Class[]
}

model Class {
  id       Int    @id @default(autoincrement())
  name     String @unique

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id])
  lessons       Lesson[]
  students      Student[]
  gradeId       Int
  grade         Grade          @relation(fields: [gradeId], references: [id])
  events        Event[]
  announcements Announcement[]
  materials     Material[]
}

model Subject {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  semester  Int?      // 1 = First semester, 2 = Second semester, null = both/full year
  teachers  Teacher[]
  lessons   Lesson[]
  materials Material[]
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime

  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  assignments Assignment[]
  attendances Attendance[]
  attendanceSessions AttendanceSession[]
}



model Assignment {
  id        Int      @id @default(autoincrement())
  title     String
  startDate DateTime
  dueDate   DateTime

  lessonId Int
  lesson   Lesson   @relation(fields: [lessonId], references: [id])
}



model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  lessonId  Int
  lesson    Lesson  @relation(fields: [lessonId], references: [id])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])
}

model Announcement {
  id              Int                 @id @default(autoincrement())
  title           String
  description     String
  date            DateTime
  targetAudience  String              @default("all") // "all", "students", "teachers"

  classId Int?
  class   Class?            @relation(fields: [classId], references: [id])
  reads   AnnouncementRead[]
}

model AnnouncementRead {
  id             Int          @id @default(autoincrement())
  announcementId Int
  userId         String
  readAt         DateTime     @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

model AttendanceSession {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  startTime DateTime @default(now())
  endTime   DateTime?
  status    SessionStatus @default(OPEN)
}

enum SessionStatus {
  OPEN
  CLOSED
}

model SchoolConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Material {
  id        Int      @id @default(autoincrement())
  title     String
  filePath  String
  createdAt DateTime @default(now())
  isGeneral Boolean  @default(false)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-Tenancy ─────────────────────────────────────────────

enum InstitutionType {
  SECONDARY_SCHOOL
  UNIVERSITY_DEPARTMENT
  TRAINING_CENTER
  PRIMARY_SCHOOL
}

model Organization {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  institutionType InstitutionType @default(UNIVERSITY_DEPARTMENT)
  metadata        Json?           // OrgMetadata: uiConfig, features (see @/types/organization.ts)
  logoUrl         String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  users              User[]
  students           Student[]
  teachers           Teacher[]
  classes            Class[]
  grades             Grade[]
  subjects           Subject[]
  lessons            Lesson[]
  assignments        Assignment[]
  assignmentSubmissions AssignmentSubmission[]
  attendances        Attendance[]
  attendanceSessions AttendanceSession[]
  announcements      Announcement[]
  announcementReads  AnnouncementRead[]
  materials          Material[]
  notifications      Notification[]
  courseEnrollments   CourseEnrollment[]
  schoolConfigs      SchoolConfig[]

  deviceHeartbeats   DeviceHeartbeat[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

model User {
  id             String        @id @default(cuid())
  clerkId        String        @unique
  email          String        @unique
  name           String?
  role           Role
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ─── Domain Models ─────────────────────────────────────────────

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  bloodType   String?
  sex         UserSex
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id])
  attendances  Attendance[]
  submissions  AssignmentSubmission[]
  enrollments  CourseEnrollment[]
  birthday     DateTime
  biometricId String?      @unique


  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([classId])
  @@index([gradeId])
  @@index([organizationId])
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String?
  img       String?
  bloodType String?
  sex       UserSex?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime?
  materials Material[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}



model Grade {
  id    Int @id @default(autoincrement())
  level Int

  students Student[]
  classess Class[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, level])
  @@index([organizationId])
}

model Class {
  id       Int      @id @default(autoincrement())
  name     String
  isActive Boolean  @default(true)

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  lessons       Lesson[]
  students      Student[]
  gradeId       Int
  grade         Grade          @relation(fields: [gradeId], references: [id])

  announcements Announcement[]
  materials     Material[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Subject {
  id        Int       @id @default(autoincrement())
  name      String
  title     String?
  credits   Int?
  level     Int?      // 100, 200, 300 etc.
  isActive  Boolean   @default(true)
  semester  Int?      // 1 = First semester, 2 = Second semester, null = both/full year
  status    String?   // "C" = Compulsory, "R" = Required, "E" = Elective
  teachers  Teacher[]
  lessons     Lesson[]
  materials   Material[]
  assignments Assignment[]
  enrollments CourseEnrollment[]
  announcements Announcement[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime
  isActive  Boolean  @default(true)

  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  attendanceSessions AttendanceSession[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([organizationId])
}



model Assignment {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  attachmentUrl String?
  startDate     DateTime
  dueDate       DateTime

  subjectId     Int
  subject       Subject  @relation(fields: [subjectId], references: [id])
  submissions   AssignmentSubmission[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([subjectId])
  @@index([organizationId])
}

model AssignmentSubmission {
  id             Int      @id @default(autoincrement())
  assignmentId   Int
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionUrl  String
  submissionDate DateTime   @default(now())
  grade          Int?
  feedback       String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([assignmentId, studentId]) // One submission per student per assignment
  @@index([assignmentId])
  @@index([studentId])
  @@index([organizationId])
}



model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  lessonId  Int
  lesson    Lesson  @relation(fields: [lessonId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([studentId, date])
  @@index([lessonId, date])
  @@index([date])
  @@index([organizationId])
}



model Announcement {
  id              Int                 @id @default(autoincrement())
  title           String
  description     String
  date            DateTime
  targetAudience  String              @default("all") // "all", "students", "teachers"

  classId Int?
  class   Class?            @relation(fields: [classId], references: [id])
  subjectId Int?
  subject   Subject?        @relation(fields: [subjectId], references: [id])
  reads   AnnouncementRead[]

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model AnnouncementRead {
  id             Int          @id @default(autoincrement())
  announcementId Int
  userId         String
  readAt         DateTime     @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([organizationId])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model AttendanceSession {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  startTime DateTime @default(now())
  endTime   DateTime?
  status    SessionStatus @default(OPEN)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

enum SessionStatus {
  OPEN
  CLOSED
}

model SchoolConfig {
  id    Int    @id @default(autoincrement())
  key   String
  value String

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Material {
  id        Int      @id @default(autoincrement())
  title     String
  filePath  String
  createdAt DateTime @default(now())
  isGeneral Boolean  @default(false)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([subjectId])
  @@index([classId])
  @@index([organizationId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([userId, isRead])
  @@index([organizationId])
}

model CourseEnrollment {
  id         Int      @id @default(autoincrement())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  Int
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([studentId, subjectId])
  @@index([studentId])
  @@index([subjectId])
  @@index([organizationId])
}


model DeviceHeartbeat {
  id        Int      @id @default(autoincrement())
  deviceId  String   @unique
  lastSeen  DateTime @default(now())
  mode      String   @default("UNKNOWN")
  wifiRSSI  Int?
  freeHeap  Int?
  sdReady   Boolean  @default(false)
  sensorStatus Boolean @default(false)
  uptime    Int      @default(0)

  pendingCommand String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([deviceId])
  @@index([organizationId])
}

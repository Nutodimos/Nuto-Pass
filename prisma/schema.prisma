generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id
  username String @unique
}

model Student {
  id          String       @id
  username    String       @unique
  name        String
  surname     String
  email       String?      @unique
  phone       String?      @unique
  address     String
  img         String?
  bloodType   String?
  sex         UserSex
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  gradeId     Int
  grade       Grade        @relation(fields: [gradeId], references: [id])
  attendances  Attendance[]
  submissions  AssignmentSubmission[]
  enrollments  CourseEnrollment[]
  birthday     DateTime
  biometricId String?      @unique

  @@index([classId])
  @@index([gradeId])
}

model Teacher {
  id        String    @id
  username  String    @unique
  name      String
  surname   String
  email     String?   @unique
  phone     String?   @unique
  address   String?
  img       String?
  bloodType String?
  sex       UserSex?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  subjects  Subject[]
  lessons   Lesson[]
  classes   Class[]
  birthday  DateTime?
  materials Material[]
}



model Grade {
  id    Int @id @default(autoincrement())
  level Int @unique

  students Student[]
  classess Class[]
}

model Class {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  isActive Boolean  @default(true)

  supervisorId  String?
  supervisor    Teacher?       @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  lessons       Lesson[]
  students      Student[]
  gradeId       Int
  grade         Grade          @relation(fields: [gradeId], references: [id])

  announcements Announcement[]
  materials     Material[]
}

model Subject {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  title     String?
  credits   Int?
  level     Int?      // 100, 200, 300 etc.
  isActive  Boolean   @default(true)
  semester  Int?      // 1 = First semester, 2 = Second semester, null = both/full year
  teachers  Teacher[]
  lessons     Lesson[]
  materials   Material[]
  assignments Assignment[]
  enrollments CourseEnrollment[]
  announcements Announcement[]
}

model Lesson {
  id        Int      @id @default(autoincrement())
  name      String
  day       Day
  startTime DateTime
  endTime   DateTime
  isActive  Boolean  @default(true)

  subjectId   Int
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classId     Int
  class       Class        @relation(fields: [classId], references: [id])
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  attendanceSessions AttendanceSession[]

  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
}



model Assignment {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  attachmentUrl String?
  startDate     DateTime
  dueDate       DateTime

  subjectId     Int
  subject       Subject  @relation(fields: [subjectId], references: [id])
  submissions   AssignmentSubmission[]

  @@index([subjectId])
}

model AssignmentSubmission {
  id             Int      @id @default(autoincrement())
  assignmentId   Int
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionUrl  String
  submissionDate DateTime   @default(now())
  grade          Int?
  feedback       String?

  @@unique([assignmentId, studentId]) // One submission per student per assignment
  @@index([assignmentId])
  @@index([studentId])
}



model Attendance {
  id      Int      @id @default(autoincrement())
  date    DateTime
  present Boolean

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  lessonId  Int
  lesson    Lesson  @relation(fields: [lessonId], references: [id])

  @@index([studentId, date])
  @@index([lessonId, date])
  @@index([date])
}



model Announcement {
  id              Int                 @id @default(autoincrement())
  title           String
  description     String
  date            DateTime
  targetAudience  String              @default("all") // "all", "students", "teachers"

  classId Int?
  class   Class?            @relation(fields: [classId], references: [id])
  subjectId Int?
  subject   Subject?        @relation(fields: [subjectId], references: [id])
  reads   AnnouncementRead[]
}

model AnnouncementRead {
  id             Int          @id @default(autoincrement())
  announcementId Int
  userId         String
  readAt         DateTime     @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

enum UserSex {
  MALE
  FEMALE
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model AttendanceSession {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  startTime DateTime @default(now())
  endTime   DateTime?
  status    SessionStatus @default(OPEN)
}

enum SessionStatus {
  OPEN
  CLOSED
}

model SchoolConfig {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Material {
  id        Int      @id @default(autoincrement())
  title     String
  filePath  String
  createdAt DateTime @default(now())
  isGeneral Boolean  @default(false)

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])

  @@index([subjectId])
  @@index([classId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

model CourseEnrollment {
  id         Int      @id @default(autoincrement())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId  Int
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, subjectId])
  @@index([studentId])
  @@index([subjectId])
}

model DeviceHeartbeat {
  id        Int      @id @default(autoincrement())
  deviceId  String   @unique
  lastSeen  DateTime @default(now())
  mode      String   @default("UNKNOWN")
  wifiRSSI  Int?
  freeHeap  Int?
  sdReady   Boolean  @default(false)
  sensorStatus Boolean @default(false)
  uptime    Int      @default(0)
  templateCount Int?
  pendingCommand String?

  @@index([deviceId])
}
